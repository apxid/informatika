<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Gimkit Humans vs. Zombies — Briefing Misi</title>
<style>
:root{--bg:#07111f;--panel:#122238;--panel2:#0b1728;--line:#2a405c;--text:#f3f7fc;--muted:#b6c7dc;--blue:#38bdf8;--cyan:#22d3ee;--green:#4ade80;--gold:#facc15;--red:#fb7185;--purple:#a78bfa}
*{box-sizing:border-box}
body{margin:0;padding:18px;min-height:100vh;background:radial-gradient(ellipse at top,#163354 0%,#07111f 62%);color:var(--text);font-family:system-ui,-apple-system,"Segoe UI",sans-serif;line-height:1.65}
.container{max-width:1000px;margin:auto}.hero{text-align:center;padding:22px 10px 18px}
.tag{display:inline-block;padding:5px 13px;border:1px solid #426283;border-radius:999px;color:#c9e6ff;font-size:.76rem;letter-spacing:1.5px;font-weight:900}
h1{font-size:clamp(1.7rem,5vw,2.8rem);line-height:1.15;margin:15px 0 8px;color:#86efac}
.subtitle{color:var(--muted);margin:0}
.progress-wrap{max-width:700px;margin:24px auto 0}.progress-label{display:flex;justify-content:space-between;font-size:.85rem;color:#d1e5fa;margin-bottom:8px}
.progress-track{height:8px;border-radius:99px;background:#26384d;overflow:hidden}.progress-fill{height:100%;width:25%;background:linear-gradient(90deg,#22c55e,#a3e635);transition:width .3s}
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:18px 0}.step{padding:10px 5px;text-align:center;border:1px solid var(--line);border-radius:12px;background:#101e31;color:#8fa7c2;font-size:.78rem}
.step span{display:block;font-size:1.15rem;font-weight:900}.step.active{border-color:var(--green);background:#123b35;color:white}.step.done{border-color:#34d399;color:#a7f3d0}
.layer{display:none;padding:clamp(18px,4vw,32px);background:rgba(18,34,56,.97);border:1px solid var(--line);border-radius:18px;box-shadow:0 20px 55px #0005;animation:show .25s ease}.layer.active{display:block}
@keyframes show{from{opacity:.4;transform:translateY(7px)}to{opacity:1;transform:translateY(0)}}
.kicker{font-size:.8rem;font-weight:900;letter-spacing:1.4px;text-transform:uppercase;color:#86efac}
h2{font-size:clamp(1.35rem,3.5vw,1.95rem);line-height:1.3;margin:6px 0 18px}h3{margin:0 0 8px}
.story{background:var(--panel2);border-left:5px solid var(--green);padding:18px;border-radius:10px;color:#d6e3f2}.story p:first-child{margin-top:0}.story p:last-child{margin-bottom:0}
.highlight{color:var(--gold);font-weight:900}.checkline{display:flex;align-items:flex-start;gap:12px;padding:15px;background:var(--panel2);border:1px solid var(--line);border-radius:12px;margin-top:20px}
.checkline input{width:22px;height:22px;flex-shrink:0;margin-top:3px;accent-color:#22c55e}.checkline label{cursor:pointer}.small{font-size:.9rem;color:var(--muted)}
.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:18px}.card{padding:17px;background:var(--panel2);border:1px solid var(--line);border-radius:13px}
.card .emoji{font-size:1.8rem}.card p{margin:7px 0 0;color:var(--muted);font-size:.94rem}
.human{border-top:4px solid var(--blue)}.zombie{border-top:4px solid var(--green)}.answer{border-top:4px solid var(--gold)}.teamwork{border-top:4px solid var(--purple)}
.human h3{color:#7dd3fc}.zombie h3{color:#86efac}.answer h3{color:var(--gold)}.teamwork h3{color:#c4b5fd}
.callout{margin-top:16px;padding:15px;border:1px dashed #5280aa;background:#0a1a2d;border-radius:12px}
.rules{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.rule{padding:17px;background:var(--panel2);border:1px solid var(--line);border-radius:12px}
.win{color:var(--green)}.avoid{color:var(--red)}ol,ul{padding-left:22px}li{margin:7px 0}
.team-container{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:20px}.team-box{text-align:center;padding:22px 18px;border-radius:16px}
.left{background:linear-gradient(145deg,#164e75,#102544);border:2px solid #38bdf8}.right{background:linear-gradient(145deg,#14532d,#102b24);border:2px solid #4ade80}
.team-box h3{font-size:1.35rem;letter-spacing:1px}.team-box p{color:#e0eafa}.pin{padding:12px;background:#02081788;border:1px dashed #ffffff55;border-radius:9px;font-weight:800;font-size:.9rem;margin:15px 0}
.btn{display:inline-flex;justify-content:center;align-items:center;border:0;border-radius:10px;padding:13px 18px;font-size:1rem;font-weight:900;cursor:pointer;text-decoration:none;color:white;transition:transform .15s,filter .15s}
.btn:hover{transform:translateY(-1px);filter:brightness(1.1)}.btn:focus-visible,input:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
.primary{background:linear-gradient(90deg,#15803d,#16a34a)}.secondary{background:#334155}.join-left{width:100%;background:#0284c7}.join-right{width:100%;background:#15803d}
.nav{display:flex;align-items:center;gap:12px;margin-top:22px;padding-top:18px;border-top:1px solid var(--line)}.nav .btn{min-width:145px}.nav .btn[hidden]{display:none}
.footer{text-align:center;color:#8298b4;font-size:.8rem;padding:22px 0}
@media(max-width:640px){body{padding:11px}.hero{padding-top:12px}.steps{gap:5px}.step{font-size:.66rem;padding:8px 2px}.step span{font-size:1rem}.cards,.rules,.team-container{grid-template-columns:1fr}.layer{border-radius:14px}.nav .btn{min-width:0;flex:1;padding:12px 9px}}
</style>
</head>
<body>
<div class="container">
<header class="hero">
  <div class="tag">MISSION BRIEFING • HUMANS VS. ZOMBIES</div>
  <h1>🧟 HUMANS vs. ZOMBIES</h1>
  <p class="subtitle">Jawab dengan teliti, bertahan hidup, dan jangan biarkan wabah menguasai permainan!</p>
  <div class="progress-wrap">
    <div class="progress-label"><span id="progressText">Tahap 1 dari 4</span><span id="progressPercent">25%</span></div>
    <div class="progress-track" id="progressBar" role="progressbar" aria-label="Kemajuan briefing" aria-valuemin="1" aria-valuemax="4" aria-valuenow="1"><div class="progress-fill" id="progressFill"></div></div>
  </div>
  <div class="steps">
    <div class="step active"><span>01</span>Latar Misi</div>
    <div class="step"><span>02</span>Panduan Main</div>
    <div class="step"><span>03</span>Cara Menang</div>
    <div class="step"><span>04</span>Masuk Game</div>
  </div>
</header>
<main>
<section class="layer active" aria-labelledby="title1">
  <div class="kicker">Tahap 1 • Baca sampai selesai</div>
  <h2 id="title1">📖 Latar Belakang Misi: Wabah Zombie</h2>
  <div class="story">
    <p>Wabah zombie menyebar dan keadaan semakin genting. Kalian memulai permainan sebagai bagian dari kelompok <b>Humans (manusia)</b>. Setiap pertanyaan adalah kesempatan untuk membuktikan pengetahuan sekaligus bertahan hidup.</p>
    <p>Dalam mode ini, jawaban yang benar sangat penting. Berdasarkan aturan mode yang digunakan, jawaban salah dapat membuat pemain berubah menjadi <b>Zombie</b>. Ketika berubah, tujuanmu ikut berubah: bantu kelompok zombie menyebarkan wabah kepada pemain yang masih manusia.</p>
    <p>Misi manusia adalah bertahan selama mungkin. Misi zombie adalah mengubah manusia sebanyak mungkin. Perhatikan pertanyaan, jangan asal menekan jawaban, dan tetap fokus sampai permainan berakhir.</p>
  </div>
  <div class="checkline">
    <input type="checkbox" id="readStory">
    <label for="readStory"><b>Saya sudah membaca Latar Belakang Misi sampai selesai.</b><br><span class="small">Centang setelah membaca cerita. Tombol lanjut akan aktif setelah kotak ini dicentang.</span></label>
  </div>
</section>

<section class="layer" aria-labelledby="title2">
  <div class="kicker">Tahap 2 • Pahami cara bermain</div>
  <h2 id="title2">🧭 Panduan Bermain Humans vs. Zombies</h2>
  <p>Ikuti aturan sesi yang ditampilkan guru. Mode atau pengaturan tertentu dapat mengubah detail permainan.</p>
  <div class="cards">
    <article class="card human"><div class="emoji">🧑</div><h3>1. Bertahan sebagai Manusia</h3><p>Baca soal dengan cermat dan pilih jawaban yang paling tepat. Jawaban benar membantu kamu tetap bertahan sebagai manusia.</p></article>
    <article class="card zombie"><div class="emoji">🧟</div><h3>2. Jika Menjadi Zombie</h3><p>Jangan berhenti bermain. Ikuti tujuan tim zombie dan coba mengubah pemain yang masih bertahan sebagai manusia.</p></article>
    <article class="card answer"><div class="emoji">🧠</div><h3>3. Utamakan Ketelitian</h3><p>Jangan terburu-buru memilih. Baca seluruh pertanyaan dan pilihan jawaban sebelum menjawab.</p></article>
    <article class="card teamwork"><div class="emoji">🤝</div><h3>4. Ikuti Perubahan Tim</h3><p>Perhatikan status atau tim yang ditampilkan game. Strategi kamu bisa berubah ketika peran manusia atau zombie berubah.</p></article>
  </div>
  <div class="callout"><b>🎮 Cara masuk dan bermain:</b>
    <ol>
      <li>Buka halaman join Gimkit melalui tombol pada tahap terakhir.</li>
      <li>Masukkan kode permainan yang diberikan guru, lalu isi nama sesuai instruksi.</li>
      <li>Tunggu di lobi sampai guru memulai permainan.</li>
      <li>Baca soal pada perangkatmu dan pilih jawaban yang benar.</li>
    </ol>
    <span class="small">Mode Humans vs. Zombies ini bukan permainan gerak 2D seperti One Way Out. Ikuti antarmuka dan instruksi yang muncul di layar perangkatmu.</span>
  </div>
</section>

<section class="layer" aria-labelledby="title3">
  <div class="kicker">Tahap 3 • Pahami tujuan akhir</div>
  <h2 id="title3">🏁 Bagaimana Cara Menang?</h2>
  <div class="rules">
    <article class="rule"><h3 class="win">✅ TUJUAN MANUSIA</h3><p>Bertahan sebagai manusia selama mungkin. Jawab pertanyaan dengan benar dan hindari kesalahan yang dapat mengubah statusmu menjadi zombie.</p></article>
    <article class="rule"><h3 class="avoid">🧟 TUJUAN ZOMBIE</h3><p>Jika sudah menjadi zombie, bantu menyebarkan wabah dengan mengubah pemain manusia lainnya sesuai mekanisme permainan.</p></article>
  </div>
  <div class="callout">
    <h3>🧠 Strategi Bertahan</h3>
    <ol>
      <li>Baca pertanyaan sampai selesai sebelum memilih jawaban.</li>
      <li>Jangan menebak secara asal; gunakan pengetahuan dari materi pelajaran.</li>
      <li>Tetap fokus meskipun pemain lain sudah berubah menjadi zombie.</li>
      <li>Perhatikan status tim dan instruksi yang muncul pada layar.</li>
      <li>Terima hasil permainan dengan sportif. Tujuan kelas adalah belajar sambil bermain.</li>
    </ol>
  </div>
  <p class="small">Catatan: aturan terperinci dapat berubah sesuai versi mode dan pengaturan sesi yang dipilih guru. Ikuti instruksi di dalam game jika ada perbedaan.</p>
</section>

<section class="layer" aria-labelledby="title4">
  <div class="kicker">Tahap 4 • Masuk ke permainan</div>
  <h2 id="title4">🖥️ Siap Menghadapi Wabah?</h2>
  <p>Gunakan tombol di bawah untuk membuka halaman bergabung resmi Gimkit. Masukkan kode sesi yang ditampilkan guru—kode tidak disediakan oleh halaman briefing ini.</p>
  <div class="team-container">
    <article class="team-box left">
      <h3>🧑 HUMANS</h3>
      <p>Fokus menjawab dengan benar dan <b>bertahan hidup</b> selama mungkin.</p>
      <div class="pin">🔑 Siapkan kode game dari guru</div>
      <a class="btn join-left" href="https://www.gimkit.com/join" target="_blank" rel="noopener noreferrer">MASUK KE GIMKIT ↗</a>
    </article>
    <article class="team-box right">
      <h3>🧟 ZOMBIES</h3>
      <p>Jika berubah menjadi zombie, lanjutkan permainan dan bantu timmu menyebarkan wabah.</p>
      <div class="pin">🎯 Ikuti status tim di layar</div>
      <a class="btn join-right" href="https://www.gimkit.com/join" target="_blank" rel="noopener noreferrer">MASUK KE GIMKIT ↗</a>
    </article>
  </div>
  <p class="small">Kedua tombol membuka halaman join yang sama. Peran manusia atau zombie ditentukan oleh permainan, bukan dengan memilih tombol di halaman ini.</p>
</section>
</main>
<nav class="nav" aria-label="Navigasi briefing">
  <button type="button" class="btn secondary" id="prevBtn" hidden>← Kembali</button>
  <span style="flex:1"></span>
  <button type="button" class="btn primary" id="nextBtn" disabled style="opacity:.55">Saya Sudah Membaca →</button>
</nav>
<footer class="footer">Baca setiap tahap sebelum melanjutkan • Tetap fokus, sportif, dan selamat dari wabah! 🧟</footer>
</div>
<script>
(() => {
  const layers = [...document.querySelectorAll('.layer')];
  const steps = [...document.querySelectorAll('.step')];
  const readStory = document.getElementById('readStory');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');
  const progressFill = document.getElementById('progressFill');
  const progressText = document.getElementById('progressText');
  const progressPercent = document.getElementById('progressPercent');
  const progressBar = document.getElementById('progressBar');
  let current = 0;
  function render(index) {
    current = Math.max(0, Math.min(index, layers.length - 1));
    layers.forEach((el, i) => {
      el.classList.toggle('active', i === current);
      el.setAttribute('aria-hidden', i === current ? 'false' : 'true');
    });
    steps.forEach((el, i) => {
      el.classList.toggle('active', i === current);
      el.classList.toggle('done', i < current);
    });
    const pct = Math.round((current + 1) / layers.length * 100);
    progressFill.style.width = pct + '%';
    progressText.textContent = `Tahap ${current + 1} dari ${layers.length}`;
    progressPercent.textContent = pct + '%';
    progressBar.setAttribute('aria-valuenow', current + 1);
    prevBtn.hidden = current === 0;
    nextBtn.hidden = current === layers.length - 1;
    nextBtn.textContent = current === 0 ? 'Saya Sudah Membaca →' :
      current === 1 ? 'Saya Paham Cara Bermain →' : 'Saya Paham Cara Menang →';
    window.scrollTo({top: 0, behavior: 'smooth'});
  }
  readStory.addEventListener('change', () => {
    nextBtn.disabled = !readStory.checked;
    nextBtn.style.opacity = readStory.checked ? '1' : '.55';
  });
  nextBtn.addEventListener('click', () => {
    if (current === 0 && !readStory.checked) return;
    render(current + 1);
  });
  prevBtn.addEventListener('click', () => render(current - 1));
  render(0);
})();
</script>
</body>
</html>
